# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files — .env holds per-developer/per-environment values (VITE_MOCK,
# VITE_API_BASE_URL) that shouldn't be shared via git. .env.example is the
# committed template.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# This is a pnpm project — pnpm-lock.yaml is the only lockfile.
# A stray package-lock.json is read by GitHub's dependency graph and
# Dependabot, so a stale one raises alerts for packages the project no
# longer has (it did exactly that for react-router-dom after the v8 move).
package-lock.json
yarn.lock
